{
  "$comment": "Single configuration source for the NodeMation pipeline. Workflows contain mechanics only; every name, label, policy and target lives here. A loader workflow syncs this file into Redis key cfg:pipeline; every workflow reads that key at the start of a run.",
  "org": "oneshotllc",
  "streams": {
    "default": "oneshotllc",
    "rules": [
      {
        "repo": "*",
        "stream": "oneshotllc"
      }
    ]
  },
  "queues": {
    "intake": "queue:intake",
    "stream_prefix": "queue:",
    "build_prefix": "queue:build:"
  },
  "keys": {
    "seen_prefix": "seen:",
    "spec_prefix": "spec:",
    "build_prefix": "build:",
    "redelivered_prefix": "redelivered:",
    "metrics_queue_depth": "metrics:queue-depth",
    "webhook_secret": "cfg:gh_webhook_secret"
  },
  "labels": {
    "hold": "hold",
    "pr_open": "pr-open",
    "shipped": "shipped",
    "needs_triage": "needs:triage"
  },
  "approvers": [
    "bwoestman"
  ],
  "bots": [
    "oneshot-pr-bot[bot]",
    "dependabot[bot]",
    "github-actions[bot]"
  ],
  "ingress": {
    "path": "github-issue-triage",
    "events": [
      "issues",
      "issue_comment",
      "pull_request",
      "pull_request_review",
      "pull_request_review_comment"
    ]
  },
  "merge": {
    "method": "squash",
    "require_state": "clean"
  },
  "dependabot": {
    "author": "dependabot[bot]",
    "auto_merge": true,
    "require_checks": true,
    "ok_conclusions": [
      "success",
      "skipped",
      "neutral"
    ]
  },
  "redelivery": {
    "window_minutes": 60,
    "once_ttl_seconds": 86400
  },
  "evidence": {
    "queue_depth_report": {
      "repo": "oneshotllc/.github",
      "issue": 29
    }
  },
  "spec": {
    "sentinel": "TDD/BDD Execution Spec"
  },
  "monitor": {
    "actions_repo": "oneshotllc/.github",
    "site_url": "https://oneshot.help/"
  },
  "config_source": {
    "repo": "oneshotllc/.github",
    "path": "automation/pipeline.json"
  },
  "chain": {
    "$comment": "Ordering inside a stream. Primary: GitHub issue dependencies (blocked_by). Fallback when that API is unavailable: a body line '<blocked_by_line> #N'.",
    "blocked_by_line": "Blocked by:"
  },
  "build": {
    "$comment": "Build stage: the build-queue consumer dispatches this workflow on the runner; the job runs the coding agent in a fresh checkout and opens the PR as the bot.",
    "dispatch_repo": "oneshotllc/.github",
    "workflow_file": "build.yml",
    "runner_label": "oneshot-mac",
    "branch_prefix": "issue-",
    "agent": "claude",
    "agent_args": [
      "-p",
      "--permission-mode",
      "acceptEdits",
      "--max-turns",
      "60"
    ],
    "timeout_minutes": 60,
    "ref": "main"
  }
}